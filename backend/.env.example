APP_NAME=FastAPI Role Management API
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/role_management
SECRET_KEY=replace-this-with-a-long-random-secret-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=redis://redis:6379/0

# First startup creates this admin if the email does not already exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Admin

# Optional SMTP settings. If omitted, Celery logs a demo welcome email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
